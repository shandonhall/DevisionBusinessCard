NEXT_PUBLIC_PLATFORM_NAME=
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet (optional - the Add to Apple Wallet button shows when all of these,
# or WALLETWALLET_API_KEY below, are set)
# Certificates/keys: PEM text, or the whole PEM base64-encoded on one line.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=

# Optional fallback until the Apple certificate above is set: WalletWallet signs
# passes with its own certificate (https://walletwallet.dev, key ww_live_...).
WALLETWALLET_API_KEY=
